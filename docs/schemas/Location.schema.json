        "customer_zone",
        "dropoff_point",
        "return_hub",
        "refurb_center",
        "liquidation_depot",
        "recycling_facility",
        "depot",
        "customer",
        "hub",
        "warehouse",
        "port"
      ],
      "title": "LocationType",
      "type": "string"
    }
  },
  "description": "Network location: customer pickup zone, drop-off point, return hub, or disposition node.",

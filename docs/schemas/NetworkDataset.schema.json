{
  "$defs": {
    "CapacityConstraint": {
      "description": "Explicit operational constraint enforced by the simulator guard.",
      "properties": {
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "scope": {
          "enum": [
            "vehicle",
            "dock",
            "hub_storage",
            "inspection",
            "driver_hos",
            "safety",
            "sla"
          ],
          "title": "Scope",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "max_weight_kg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Weight Kg"
        },
        "max_volume_m3": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Volume M3"
        },
        "max_units": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Units"
        },
        "max_concurrent_slots": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Concurrent Slots"
        },
        "max_shift_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Shift Minutes"
        },
        "min_on_time_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min On Time Rate"
        },
        "require_hazmat_cert": {
          "default": false,
          "title": "Require Hazmat Cert",
          "type": "boolean"
        },
        "hard": {
          "default": true,
          "title": "Hard",
          "type": "boolean"
        }
      },
      "required": [
        "constraint_id",
        "scope",
        "target_id"
      ],
      "title": "CapacityConstraint",
      "type": "object"
    },
    "DispositionOutcome": {
      "description": "Triage disposition path determined during hub inspection.",
      "enum": [
        "restock",
        "refurbish",
        "liquidate",
        "recycle"
      ],
      "title": "DispositionOutcome",
      "type": "string"
    },
    "Driver": {
      "description": "Driver paired with a vehicle and bound by Hours-of-Service (HOS) rules.",
      "properties": {
        "driver_id": {
          "title": "Driver Id",
          "type": "string"
        },
        "assigned_vehicle_id": {
          "title": "Assigned Vehicle Id",
          "type": "string"
        },
        "max_shift_minutes": {
          "default": 480.0,
          "exclusiveMinimum": 0,
          "title": "Max Shift Minutes",
          "type": "number"
        },
        "calendar_id": {
          "default": "cal_driver_day",
          "title": "Calendar Id",
          "type": "string"
        }
      },
      "required": [
        "driver_id",
        "assigned_vehicle_id"
      ],
      "title": "Driver",
      "type": "object"
    },
    "HandlingClass": {
      "description": "Physical and safety handling classification of returned SKUs.",
      "enum": [
        "standard",
        "fragile",
        "hazmat_battery"
      ],
      "title": "HandlingClass",
      "type": "string"
    },
    "InventoryPosition": {
      "description": "Inventory state at a hub for a given SKU.",
      "properties": {
        "timestamp_minute": {
          "minimum": 0,
          "title": "Timestamp Minute",
          "type": "number"
        },
        "location_id": {
          "title": "Location Id",
          "type": "string"
        },
        "sku_id": {
          "title": "Sku Id",
          "type": "string"
        },
        "on_hand_restock_units": {
          "default": 0,
          "minimum": 0,
          "title": "On Hand Restock Units",
          "type": "integer"
        },
        "quarantined_units": {
          "default": 0,
          "minimum": 0,
          "title": "Quarantined Units",
          "type": "integer"
        },
        "in_inspection_units": {
          "default": 0,
          "minimum": 0,
          "title": "In Inspection Units",
          "type": "integer"
        },
        "refurb_kit_units": {
          "default": 40,
          "minimum": 0,
          "title": "Refurb Kit Units",
          "type": "integer"
        },
        "backorder_units": {
          "default": 0,
          "minimum": 0,
          "title": "Backorder Units",
          "type": "integer"
        },
        "reorder_point": {
          "default": 10,
          "minimum": 0,
          "title": "Reorder Point",
          "type": "integer"
        }
      },
      "required": [
        "timestamp_minute",
        "location_id",
        "sku_id"
      ],
      "title": "InventoryPosition",
      "type": "object"
    },
    "Lane": {
      "description": "Directed transport lane connecting two locations.",
      "properties": {
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "origin_id": {
          "title": "Origin Id",
          "type": "string"
        },
        "destination_id": {
          "title": "Destination Id",
          "type": "string"
        },
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "base_transit_minutes": {
          "minimum": 0,
          "title": "Base Transit Minutes",
          "type": "number"
        },
        "cost_per_km": {
          "minimum": 0,
          "title": "Cost Per Km",
          "type": "number"
        },
        "fixed_dispatch_cost": {
          "default": 12.0,
          "minimum": 0,
          "title": "Fixed Dispatch Cost",
          "type": "number"
        },
        "emission_kg_co2_per_km": {
          "default": 0.27,
          "minimum": 0,
          "title": "Emission Kg Co2 Per Km",
          "type": "number"
        },
        "is_cross_border": {
          "default": false,
          "title": "Is Cross Border",
          "type": "boolean"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        }
      },
      "required": [
        "lane_id",
        "origin_id",
        "destination_id",
        "distance_km",
        "base_transit_minutes",
        "cost_per_km"
      ],
      "title": "Lane",
      "type": "object"
    },
    "Location": {
      "description": "Network location: customer pickup zone, drop-off point, return hub, or disposition node.",
      "properties": {
        "location_id": {
          "title": "Location Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location_type": {
          "$ref": "#/$defs/LocationType"
        },
        "x_km": {
          "title": "X Km",
          "type": "number"
        },
        "y_km": {
          "title": "Y Km",
          "type": "number"
        },
        "dock_count": {
          "default": 0,
          "minimum": 0,
          "title": "Dock Count",
          "type": "integer"
        },
        "inspection_bays": {
          "default": 0,
          "minimum": 0,
          "title": "Inspection Bays",
          "type": "integer"
        },
        "robot_units": {
          "default": 0,
          "minimum": 0,
          "title": "Robot Units",
          "type": "integer"
        },
        "storage_capacity_units": {
          "default": 0,
          "minimum": 0,
          "title": "Storage Capacity Units",
          "type": "integer"
        },
        "calendar_id": {
          "default": "cal_standard",
          "title": "Calendar Id",
          "type": "string"
        }
      },
      "required": [
        "location_id",
        "name",
        "location_type",
        "x_km",
        "y_km"
      ],
      "title": "Location",
      "type": "object"
    },
    "LocationType": {
      "description": "Node types in the reverse & forward logistics network.",
      "enum": [
        "customer_zone",
        "dropoff_point",
        "return_hub",
        "refurb_center",
        "liquidation_depot",
        "recycling_facility",
        "depot",
        "customer",
        "hub",
        "warehouse",
        "port"
      ],
      "title": "LocationType",
      "type": "string"
    },
    "Order": {
      "description": "Customer return order / RMA shipment in the reverse-logistics network.",
      "properties": {
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "sku_id": {
          "title": "Sku Id",
          "type": "string"
        },
        "quantity": {
          "exclusiveMinimum": 0,
          "title": "Quantity",
          "type": "integer"
        },
        "origin_id": {
          "title": "Origin Id",
          "type": "string"
        },
        "destination_hub_id": {
          "title": "Destination Hub Id",
          "type": "string"
        },
        "created_minute": {
          "minimum": 0,
          "title": "Created Minute",
          "type": "number"
        },
        "promise_window_start_minute": {
          "minimum": 0,
          "title": "Promise Window Start Minute",
          "type": "number"
        },
        "promise_window_end_minute": {
          "exclusiveMinimum": 0,
          "title": "Promise Window End Minute",
          "type": "number"
        },
        "return_reason": {
          "default": "size_or_fit",
          "title": "Return Reason",
          "type": "string"
        },
        "reported_condition": {
          "default": "opened_good",
          "title": "Reported Condition",
          "type": "string"
        },
        "true_disposition": {
          "$ref": "#/$defs/DispositionOutcome",
          "default": "restock"
        },
        "priority": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Priority",
          "type": "integer"
        },
        "requires_safety_segregation": {
          "default": false,
          "title": "Requires Safety Segregation",
          "type": "boolean"
        },
        "cancel_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Minute"
        },
        "is_synthetic": {
          "default": true,
          "title": "Is Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "order_id",
        "sku_id",
        "quantity",
        "origin_id",
        "destination_hub_id",
        "created_minute",
        "promise_window_start_minute",
        "promise_window_end_minute"
      ],
      "title": "Order",
      "type": "object"
    },
    "Picker": {
      "description": "Human warehouse return inspector / grader at a hub.",
      "properties": {
        "picker_id": {
          "title": "Picker Id",
          "type": "string"
        },
        "hub_id": {
          "title": "Hub Id",
          "type": "string"
        },
        "inspection_speed_multiplier": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Inspection Speed Multiplier",
          "type": "number"
        },
        "calendar_id": {
          "default": "cal_hub_shift",
          "title": "Calendar Id",
          "type": "string"
        }
      },
      "required": [
        "picker_id",
        "hub_id"
      ],
      "title": "Picker",
      "type": "object"
    },
    "ResourceCalendar": {
      "description": "Operating shift and working-day calendar.",
      "properties": {
        "calendar_id": {
          "title": "Calendar Id",
          "type": "string"
        },
        "shift_start_hour": {
          "default": 6,
          "maximum": 23,
          "minimum": 0,
          "title": "Shift Start Hour",
          "type": "integer"
        },
        "shift_end_hour": {
          "default": 22,
          "maximum": 24,
          "minimum": 1,
          "title": "Shift End Hour",
          "type": "integer"
        },
        "working_days": {
          "items": {
            "type": "integer"
          },
          "title": "Working Days",
          "type": "array"
        },
        "max_continuous_hours": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "title": "Max Continuous Hours",
          "type": "number"
        }
      },
      "required": [
        "calendar_id"
      ],
      "title": "ResourceCalendar",
      "type": "object"
    },
    "Robot": {
      "description": "Autonomous mobile / sortation robot moving graded returns into disposition bins.",
      "properties": {
        "robot_id": {
          "title": "Robot Id",
          "type": "string"
        },
        "hub_id": {
          "title": "Hub Id",
          "type": "string"
        },
        "max_payload_kg": {
          "default": 50.0,
          "exclusiveMinimum": 0,
          "title": "Max Payload Kg",
          "type": "number"
        },
        "move_minutes_per_task": {
          "default": 2.5,
          "exclusiveMinimum": 0,
          "title": "Move Minutes Per Task",
          "type": "number"
        }
      },
      "required": [
        "robot_id",
        "hub_id"
      ],
      "title": "Robot",
      "type": "object"
    },
    "SKU": {
      "description": "Stock-keeping unit metadata including reverse recovery & safety specs.",
      "properties": {
        "sku_id": {
          "title": "Sku Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "unit_weight_kg": {
          "exclusiveMinimum": 0,
          "title": "Unit Weight Kg",
          "type": "number"
        },
        "unit_volume_m3": {
          "exclusiveMinimum": 0,
          "title": "Unit Volume M3",
          "type": "number"
        },
        "unit_value_usd": {
          "minimum": 0,
          "title": "Unit Value Usd",
          "type": "number"
        },
        "recovery_value_usd": {
          "minimum": 0,
          "title": "Recovery Value Usd",
          "type": "number"
        },
        "handling_class": {
          "$ref": "#/$defs/HandlingClass",
          "default": "standard"
        },
        "inspection_minutes": {
          "exclusiveMinimum": 0,
          "title": "Inspection Minutes",
          "type": "number"
        },
        "restockable": {
          "default": true,
          "title": "Restockable",
          "type": "boolean"
        },
        "refurbishable": {
          "default": true,
          "title": "Refurbishable",
          "type": "boolean"
        },
        "refurb_kit_sku_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Refurb Kit Sku Id"
        }
      },
      "required": [
        "sku_id",
        "name",
        "category",
        "unit_weight_kg",
        "unit_volume_m3",
        "unit_value_usd",
        "recovery_value_usd",
        "inspection_minutes"
      ],
      "title": "SKU",
      "type": "object"
    },
    "Vehicle": {
      "description": "Reverse pickup vehicle with capacity, speed, emissions, and hazmat certification.",
      "properties": {
        "vehicle_id": {
          "title": "Vehicle Id",
          "type": "string"
        },
        "home_hub_id": {
          "title": "Home Hub Id",
          "type": "string"
        },
        "capacity_kg": {
          "exclusiveMinimum": 0,
          "title": "Capacity Kg",
          "type": "number"
        },
        "capacity_m3": {
          "exclusiveMinimum": 0,
          "title": "Capacity M3",
          "type": "number"
        },
        "capacity_units": {
          "exclusiveMinimum": 0,
          "title": "Capacity Units",
          "type": "integer"
        },
        "hazmat_certified": {
          "default": false,
          "title": "Hazmat Certified",
          "type": "boolean"
        },
        "speed_kmph": {
          "default": 45.0,
          "exclusiveMinimum": 0,
          "title": "Speed Kmph",
          "type": "number"
        },
        "cost_per_hour": {
          "default": 32.0,
          "minimum": 0,
          "title": "Cost Per Hour",
          "type": "number"
        },
        "cost_per_km": {
          "default": 1.15,
          "minimum": 0,
          "title": "Cost Per Km",
          "type": "number"
        },
        "emission_kg_co2_per_km": {
          "default": 0.27,
          "minimum": 0,
          "title": "Emission Kg Co2 Per Km",
          "type": "number"
        },
        "calendar_id": {
          "default": "cal_driver_day",
          "title": "Calendar Id",
          "type": "string"
        }
      },
      "required": [
        "vehicle_id",
        "home_hub_id",
        "capacity_kg",
        "capacity_m3",
        "capacity_units"
      ],
      "title": "Vehicle",
      "type": "object"
    }
  },
  "description": "Normalized reverse-logistics dataset snapshot ready for simulation.",
  "properties": {
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "is_synthetic": {
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "skus": {
      "items": {
        "$ref": "#/$defs/SKU"
      },
      "title": "Skus",
      "type": "array"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "array"
    },
    "lanes": {
      "items": {
        "$ref": "#/$defs/Lane"
      },
      "title": "Lanes",
      "type": "array"
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/Order"
      },
      "title": "Orders",
      "type": "array"
    },
    "initial_inventory": {
      "items": {
        "$ref": "#/$defs/InventoryPosition"
      },
      "title": "Initial Inventory",
      "type": "array"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/Vehicle"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "drivers": {
      "items": {
        "$ref": "#/$defs/Driver"
      },
      "title": "Drivers",
      "type": "array"
    },
    "pickers": {
      "items": {
        "$ref": "#/$defs/Picker"
      },
      "title": "Pickers",
      "type": "array"
    },
    "robots": {
      "items": {
        "$ref": "#/$defs/Robot"
      },
      "title": "Robots",
      "type": "array"
    },
    "calendars": {
      "items": {
        "$ref": "#/$defs/ResourceCalendar"
      },
      "title": "Calendars",
      "type": "array"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/CapacityConstraint"
      },
      "title": "Constraints",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "snapshot_id",
    "generated_at",
    "skus",
    "locations",
    "lanes",
    "orders",
    "initial_inventory",
    "vehicles",
    "drivers",
    "pickers",
    "robots",
    "calendars",
    "constraints"
  ],
  "title": "NetworkDataset",
  "type": "object"
}

{
  "description": "Content-addressed dataset snapshot provenance manifest.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
    },
    "source_sha256": {
      "title": "Source Sha256",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "canonical_sha256": {
      "title": "Canonical Sha256",
      "type": "string"
    },
    "generator_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generator Version"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    }
  },
  "required": [
    "snapshot_id",
    "synthetic",
    "source_sha256",
    "source_name",
    "row_count",
    "canonical_sha256"
  ],
  "title": "SnapshotManifest",
  "type": "object"
}

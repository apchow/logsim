      "required": [
        "run_id",
        "policy_id",
        "policy_version",
        "scenario_id",
        "scenario_version",
        "seed",
        "total_orders",
        "completed_orders",
        "on_time_orders",
        "late_orders",
        "cancelled_orders",
        "on_time_delivery_rate",
        "fill_rate",
        "cost_per_order",
        "total_cost",
        "recovery_value",
        "net_cost_after_recovery",
        "resource_utilization",
        "dock_utilization",
        "inspector_utilization",
        "throughput_orders_per_day",
        "avg_cycle_time_minutes",
        "p95_cycle_time_minutes",
        "stockouts",
        "backorders",
        "empty_miles_km",
        "total_miles_km",
        "carbon_kg_co2",
        "constraint_violations",
        "exceptions_raised"
      ],
      "title": "KPIResult",
      "type": "object"
    }
  },
  "description": "Reproducible experiment run ledger record.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "experiment_name": {
      "title": "Experiment Name",
      "type": "string"
    },
    "config_hash": {
      "title": "Config Hash",
      "type": "string"
    },
    "git_commit": {
      "title": "Git Commit",
      "type": "string"
    },
    "git_dirty": {
      "default": false,
      "title": "Git Dirty",
      "type": "boolean"
    },
    "dependency_lock_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dependency Lock Hash"
    },
    "data_snapshot_id": {
      "title": "Data Snapshot Id",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "policy_id": {
      "title": "Policy Id",
      "type": "string"
    },
    "policy_type": {
      "title": "Policy Type",
      "type": "string"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "scenario_id": {
      "title": "Scenario Id",
      "type": "string"
    },
    "scenario_version": {
      "title": "Scenario Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "runtime_seconds": {
      "minimum": 0,
      "title": "Runtime Seconds",
      "type": "number"
    },
    "metrics": {
      "$ref": "#/$defs/KPIResult"
    },
    "artifact_paths": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "object"
    },
    "mlflow_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mlflow Run Id"
    }
  },
  "required": [
    "run_id",
    "experiment_name",
    "config_hash",
    "git_commit",
    "data_snapshot_id",
    "seed",
    "policy_id",
    "policy_type",
    "policy_version",
    "scenario_id",
    "scenario_version",
    "status",
    "started_at",
    "finished_at",
    "runtime_seconds",
    "metrics"
  ],
  "title": "ExperimentRun",
  "type": "object"
}
